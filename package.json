{
  "name": "llm-bench-radar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "data:v2:build-draft": "pnpm --filter @llm-bench/benchmark-data data:build-draft",
    "data:v2:draft": "pnpm --filter @llm-bench/benchmark-data data:draft",
    "data:v2:materialize-costs": "pnpm --filter @llm-bench/acquisition materialize:costs",
    "data:v2:materialize-organizers": "pnpm --filter @llm-bench/acquisition materialize:organizers",
    "data:v2:materialize-snapshots": "pnpm --filter @llm-bench/acquisition materialize:snapshots",
    "data:v2:publish": "pnpm --filter @llm-bench/benchmark-data data:publish",
    "data:v2:rollback": "pnpm --filter @llm-bench/benchmark-data data:rollback",
    "dev": "turbo run dev --parallel",
    "e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "catalog:",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
