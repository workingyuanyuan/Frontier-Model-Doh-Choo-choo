{
  "name": "llm-bench-radar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @llm-bench/db db:generate",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @llm-bench/db db:migrate",
    "db:seed": "pnpm --filter @llm-bench/db db:seed",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "ingest:livebench": "pnpm --filter @llm-bench/worker ingest:livebench",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
