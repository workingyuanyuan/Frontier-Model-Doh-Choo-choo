{
  "name": "llm-bench-radar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "data:v2:draft": "pnpm --filter @llm-bench/benchmark-data data:draft",
    "data:v2:publish": "pnpm --filter @llm-bench/benchmark-data data:publish",
    "data:v2:rollback": "pnpm --filter @llm-bench/benchmark-data data:rollback",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @llm-bench/db db:generate",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @llm-bench/db db:migrate",
    "db:seed": "pnpm --filter @llm-bench/db db:seed",
    "db:up": "docker compose up -d --wait postgres",
    "edition": "pnpm --filter @llm-bench/worker edition",
    "e2e": "playwright test",
    "e2e:seed": "tsx apps/web/e2e/seed.ts",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "fetch:livebench-inventory": "pnpm --filter @llm-bench/worker fetch:livebench-inventory",
    "fetch:livebench-judgments": "pnpm --filter @llm-bench/worker fetch:livebench-judgments",
    "ingest:livebench": "pnpm --filter @llm-bench/worker ingest:livebench",
    "ingest:livebench:all": "pnpm --filter @llm-bench/worker ingest:livebench:all",
    "local:prepare": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm --filter @llm-bench/worker build",
    "local:up": "pnpm local:prepare && pnpm dev",
    "lint": "eslint . --max-warnings 0",
    "promote:livebench-results": "pnpm --filter @llm-bench/worker promote:livebench-results",
    "score:livebench": "pnpm --filter @llm-bench/worker score:livebench",
    "report:livebench-aggregation": "pnpm --filter @llm-bench/worker report:livebench-aggregation",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck",
    "review:livebench-aliases": "pnpm --filter @llm-bench/worker review:livebench-aliases",
    "resolve:livebench-aliases": "pnpm --filter @llm-bench/worker resolve:livebench-aliases",
    "sync:livebench-aliases": "pnpm --filter @llm-bench/worker sync:livebench-aliases",
    "verify:livebench-aliases": "pnpm --filter @llm-bench/worker verify:livebench-aliases",
    "preweekly": "turbo run build --filter=@llm-bench/worker... --filter=@llm-bench/video...",
    "weekly": "pnpm --filter @llm-bench/worker weekly",
    "weekly:dry-run": "pnpm weekly",
    "weekly:apply-preview": "pnpm weekly -- --apply-preview",
    "video:render": "pnpm --filter @llm-bench/video render",
    "video:artifacts": "pnpm --filter @llm-bench/video artifacts",
    "video:edition": "pnpm --filter @llm-bench/video edition",
    "video:still": "pnpm --filter @llm-bench/video still",
    "video:studio": "pnpm --filter @llm-bench/video studio"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "catalog:",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
