{
  "name": "@llm-bench/acquisition",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "materialize:snapshots": "tsx src/materialize-snapshots.ts",
    "materialize:costs": "tsx src/materialize-costs.ts",
    "materialize:frontier-code": "tsx src/refresh-with-audit.ts frontier-code src/refresh-frontier-code.ts",
    "materialize:frontier-swe": "tsx src/refresh-with-audit.ts frontier-swe src/refresh-frontier-swe.ts",
    "materialize:chartography": "tsx src/refresh-with-audit.ts surge-chartography src/refresh-surge-chartography.ts",
    "materialize:vendor-releases": "tsx src/refresh-with-audit.ts openai-releases,anthropic-releases src/refresh-vendor-releases.ts",
    "materialize:effort-reports": "tsx src/write-effort-inference-reports.ts",
    "materialize:deepswe": "tsx src/refresh-with-audit.ts deepswe src/refresh-deepswe.ts",
    "materialize:epoch": "tsx src/refresh-with-audit.ts epoch-ai src/refresh-epoch.ts",
    "materialize:arc-prize": "tsx src/refresh-with-audit.ts arc-prize src/refresh-arc-prize.ts",
    "materialize:zapier": "tsx src/refresh-with-audit.ts zapier-automationbench src/refresh-zapier.ts",
    "materialize:vals": "tsx src/refresh-with-audit.ts vals-ai src/refresh-vals.ts",
    "rematerialize:vals": "tsx src/rematerialize-vals.ts",
    "materialize:livebench": "tsx src/refresh-with-audit.ts livebench src/refresh-livebench.ts",
    "materialize:artificial-analysis": "node --env-file-if-exists=../../.env.local --import tsx/esm src/refresh-with-audit.ts artificial-analysis src/refresh-artificial-analysis.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "report:source-changes": "tsx src/report-source-changes.ts",
    "materialize:complex-constraints": "tsx src/refresh-with-audit.ts surge-complex-constraints src/refresh-surge-complex-constraints.ts",
    "materialize:corecraft": "tsx src/refresh-with-audit.ts surge-corecraft src/refresh-surge-corecraft.ts",
    "materialize:riemann": "tsx src/refresh-with-audit.ts surge-riemann src/refresh-surge-riemann.ts",
    "materialize:dayjob-finance": "tsx src/refresh-with-audit.ts surge-dayjob-finance src/refresh-surge-dayjob-finance.ts",
    "materialize:dayjob-healthcare": "tsx src/refresh-with-audit.ts surge-dayjob-healthcare src/refresh-surge-dayjob-healthcare.ts",
    "materialize:gdp-xlsx": "tsx src/refresh-with-audit.ts surge-gdp-xlsx src/refresh-surge-gdp-xlsx.ts"
  },
  "dependencies": {
    "@llm-bench/benchmark-data": "workspace:*",
    "adm-zip": "^0.6.1",
    "prettier": "3.9.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
