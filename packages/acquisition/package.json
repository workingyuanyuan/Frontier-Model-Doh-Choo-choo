{
  "name": "@llm-bench/acquisition",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "materialize:snapshots": "tsx src/materialize-snapshots.ts",
    "materialize:costs": "tsx src/materialize-costs.ts",
    "materialize:frontier-code": "tsx src/refresh-frontier-code.ts",
    "materialize:effort-reports": "tsx src/write-effort-inference-reports.ts",
    "materialize:deepswe": "tsx src/refresh-deepswe.ts",
    "materialize:livebench": "tsx src/refresh-livebench.ts",
    "materialize:artificial-analysis": "node --env-file=../../.env.local --import tsx/esm src/refresh-artificial-analysis.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@llm-bench/benchmark-data": "workspace:*",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
