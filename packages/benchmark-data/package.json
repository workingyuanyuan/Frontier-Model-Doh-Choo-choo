{
  "name": "@llm-bench/benchmark-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "data:build-current": "tsx src/cli.ts build-workspace ../..",
    "report:coverage-matrix": "tsx src/report-coverage-matrix.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "data:generate-display-set": "tsx src/generate-display-set.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
