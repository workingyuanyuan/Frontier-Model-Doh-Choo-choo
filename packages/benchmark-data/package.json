{
  "name": "@llm-bench/benchmark-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "data:build-draft": "tsx src/cli.ts build-workspace ../..",
    "data:draft": "tsx src/cli.ts write-draft",
    "data:publish": "tsx src/cli.ts publish",
    "data:rollback": "tsx src/cli.ts rollback",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "4.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
